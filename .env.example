# Deprecated: split into per-package env examples.
# - Web (public Vite vars only): `packages/web/.env.example`
# - API (server-only secrets): `packages/api/.env.example`


# Paystack: keep test and live keys separate. Test is the default and is admin-only.
PAYSTACK_MODE=test
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=
PAYSTACK_CURRENCY=GHS
# Pricing plans and credit packs are denominated in USD. Set an explicit conversion rate.
PAYSTACK_FX_RATE=1
# Optional trusted database CA in PEM format. Remote database certificates are verified.
PG_SSL_CA=
# Demo content is disabled unless explicitly enabled outside production.
ALLOW_DEMO_DATA=false
