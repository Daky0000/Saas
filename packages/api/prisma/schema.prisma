// ---------------------------------------------------------------------------
// Leads module schema.
//
// Prisma is used ONLY by the vendored lead-generation module in
// src/server/leads. Every other table in this database is created and queried
// through the raw `pg` pool in src/db.ts and src/db-migrations.ts — do not add
// host models here.
//
// Tables are NOT created by `prisma migrate`. They are created by the host's
// own idempotent migration runner (src/db-migrations.ts, `leadgenTables`), so
// the project keeps a single migration path. The SQL there is generated from
// this file with:
//
//   npx prisma migrate diff --from-empty \
//     --to-schema-datamodel prisma/schema.prisma --script
//
// Change this file and that SQL together, or Prisma will query columns that
// do not exist.
//
// Two deliberate departures from the module's shipped fragment:
//
//  1. Every model carries `userId`. The module has no notion of tenancy; the
//     host is multi-tenant and scopes everything by user. It is injected into
//     every query by the client extension in src/server/leads-tenancy.ts, so
//     the module's own code never mentions it.
//
//     That is also why it is `@default("")` rather than plainly required: the
//     module's create calls don't pass it, and a required field would fail to
//     compile at seven call sites that are correct at runtime. The default is
//     never written — the extension overwrites it on every create — and the
//     column has a foreign key to users(id), so a "" that did somehow escape
//     is rejected by Postgres rather than becoming an invisible orphan row.
//
//  2. The unique constraints that were global — Lead.dedupeKey, LeadGroup.slug,
//     LeadField(groupId, key) — are now per-user. Global ones would let one
//     user's import collide with, or upsert into, another user's rows.
//
// Table names are prefixed `leadgen_` so they never collide with the host's
// existing `leads` / `lead_groups` tables, which belong to a different feature.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadSource {
  REFERRAL
  LINKEDIN
  COLD_EMAIL
  OUTREACH
  CONTENT
  WARM_NETWORK
  // Machine-sourced: everything below arrives from a scraper or an import
  // rather than a person typing it in.
  GOOGLE_MAPS
  WEB_SCRAPE
  DIRECTORY
  SOCIAL
  OTHER
}

enum LeadStatus {
  NEW
  QUALIFYING
  QUALIFIED
  DISQUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id                String     @id @default(cuid())
  /// Owning host user. Injected by the tenancy extension, never by the module.
  /// See the note on tenancy at the top of this file for why it has a default.
  userId            String     @default("")
  contactName       String
  contactEmail      String?
  contactPhone      String?
  companyName       String?
  source            LeadSource @default(OTHER)
  status            LeadStatus @default(NEW)
  leadScore         Int        @default(0) // 0-100
  discoveryCallAt   DateTime?
  discoveryNotes    String?
  estimatedDealSize Decimal?   @db.Decimal(12, 2)
  winLossReason     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // --- Firmographics, mostly filled by imports and scrapers ----------------
  website      String?
  address      String?
  city         String?
  region       String?
  country      String?
  category     String? // "Dental clinic", "Law firm" — line of business
  rating       Decimal? @db.Decimal(3, 2)
  reviewsCount Int?
  latitude     Float?
  longitude    Float?
  socialLinks  Json? // { facebook, instagram, linkedin, twitter }
  tags         String[] @default([])

  /// The provider's own id (Google place id, profile URL). Kept for re-scraping
  /// the same record; `dedupeKey` is what actually prevents duplicates, since a
  /// business found twice must collapse into one lead.
  externalId String?
  /// Normalised identity: place id, else website domain, else email, else
  /// phone, else name+city. Unique per user, so a re-run updates rather than
  /// duplicates — and two users importing the same company keep their own row.
  dedupeKey  String?
  /// The untouched source row, so a mapping fix can be replayed without re-importing.
  enrichment Json?

  /// Values for columns that aren't Lead scalars — `{ "<LeadField.key>": value }`.
  /// This is what lets an imported sheet keep every one of its columns instead
  /// of losing the ones the fixed schema has no home for.
  customFields Json?

  /// Set by `convertLead` in src/server/leads/config.ts — the id of whatever
  /// the host calls a customer. Deliberately not a foreign key.
  clientId String?

  /// Free-form provenance columns for a scraper integration.
  scraperSourceId String?
  scraperRunId    String?

  group      LeadGroup?     @relation(fields: [groupId], references: [id])
  groupId    String?
  activities LeadActivity[]

  @@unique([userId, dedupeKey])
  @@index([userId, status])
  @@index([groupId])
  @@index([userId, source, createdAt])
  @@map("leadgen_leads")
}

/// A named bucket of leads — normally one import batch or one scrape run — so
/// the pipeline stays readable when 200 rows land at once.
model LeadGroup {
  id          String   @id @default(cuid())
  userId      String   @default("")
  name        String
  slug        String
  description String?
  /// Groups an import or a scraper opened automatically, as opposed to ones
  /// made by hand.
  autoCreated Boolean  @default(false)
  /// Where an imported group came from — "Contacts!A5:F210" — so a re-import
  /// can be traced.
  sourceLabel String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadImport   LeadImport? @relation(fields: [leadImportId], references: [id])
  leadImportId String?

  leads  Lead[]
  fields LeadField[]

  @@unique([userId, slug])
  @@index([leadImportId])
  @@index([userId])
  @@map("leadgen_lead_groups")
}

// ---------------------------------------------------------------------------
// Lead columns — the shape of the leads table itself
// ---------------------------------------------------------------------------

enum LeadFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  DATE
  BOOLEAN
  EMAIL
  PHONE
  URL
  SELECT
}

/// One column of the leads table. `builtin` fields address a Lead scalar by
/// `key` (contactName, city, …); the rest are stored in `Lead.customFields`
/// under the same key, which is how an imported sheet keeps columns the fixed
/// schema has never heard of.
///
/// A row with `groupId = null` belongs to that user's default column set. A
/// group with its own rows overrides that set entirely.
model LeadField {
  id       String        @id @default(cuid())
  userId   String        @default("")
  group    LeadGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String?
  key      String
  label    String
  type     LeadFieldType @default(TEXT)
  builtin  Boolean       @default(false)
  hidden   Boolean       @default(false)
  position Int           @default(0)
  /// Column width in pixels, when someone has dragged one.
  width    Int?
  /// SELECT options, and whatever the importer learned about the column.
  meta     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Postgres treats NULLs as distinct, so this constraint only binds
  // group-scoped rows; uniqueness inside the default set is enforced in
  // services/leadFields.ts.
  @@unique([userId, groupId, key])
  @@index([groupId, position])
  @@map("leadgen_lead_fields")
}

// ---------------------------------------------------------------------------
// Contact history
// ---------------------------------------------------------------------------

enum LeadActivityType {
  EMAIL
  CALL
  MESSAGE
  MEETING
  NOTE
}

/// A call, email or meeting logged against a lead. The actor is stored as a
/// loose id + name rather than a User relation — see `resolveActor` in
/// src/server/leads/config.ts.
model LeadActivity {
  id         String           @id @default(cuid())
  userId     String           @default("")
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  type       LeadActivityType @default(NOTE)
  summary    String
  outcome    String?
  occurredAt DateTime         @default(now())
  actorId    String?
  actorName  String?
  createdAt  DateTime         @default(now())

  @@index([leadId, occurredAt])
  @@map("leadgen_lead_activities")
}

// ---------------------------------------------------------------------------
// Spreadsheet imports
// ---------------------------------------------------------------------------

enum LeadImportSource {
  UPLOAD
  GOOGLE_SHEET
  GOOGLE_DRIVE_FILE
}

enum LeadImportStatus {
  ANALYZING
  READY
  IMPORTED
  FAILED
}

/// One run of "read this spreadsheet and turn it into leads". Holds the plan
/// the analyst produced — every table it found, with each table's columns and
/// where its rows start — so it can be corrected before anything is written,
/// and so a bad import can be explained afterwards.
model LeadImport {
  id     String           @id @default(cuid())
  userId String           @default("")
  source LeadImportSource @default(UPLOAD)
  status LeadImportStatus @default(ANALYZING)

  fileName   String?
  /// Remote file id, when the sheet came from a connected drive.
  driveFileId String?
  /// The tabs that were read.
  sheetNames String[] @default([])

  /// The analysed plan, as edited before commit. See services/sheetPlan.ts.
  plan Json?
  /// The analyst model's name when one ran, "rules" when the fallback did.
  analyzedBy String?
  /// The analyst's own summary of what it found and what looked doubtful.
  notes      String?
  error      String?

  tablesFound   Int @default(0)
  groupsCreated Int @default(0)
  leadsCreated  Int @default(0)
  leadsUpdated  Int @default(0)
  rowsSkipped   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups LeadGroup[]

  @@index([userId, createdAt])
  @@map("leadgen_lead_imports")
}
